# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/mayorshall"

# Session secret. Generate one with: openssl rand -base64 33
AUTH_SECRET=""
# The app's public URL. Required in production; omit for local development.
# AUTH_URL="https://your-domain.example"
# Set to true when running behind a proxy (Railway, Fly, Render)
# AUTH_TRUST_HOST="true"

# Sign in links are emailed through Resend (https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM="May or Shall <onboarding@resend.dev>"

# Where uploaded PDFs are written
STORAGE_DIR="./storage"

# Optional. Enables the AI features (traverse drafting, brief generation)
# ANTHROPIC_API_KEY="sk-ant-..."
# Optional model overrides
# MODEL_DRAFTING="claude-sonnet-5"
# MODEL_BRIEF="claude-opus-4-8"
# Optional. Where the AI prompt templates live (default: ./prompts)
# PROMPTS_DIR="./prompts"
