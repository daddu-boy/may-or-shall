generator client {
  provider = "prisma-client-js"
}

// PostgreSQL (hosted, multi-user). The schema keeps the provider-agnostic shape
// the desktop SQLite build used — enum-like fields are String (validated by zod
// at the API boundary; canonical lists in src/lib/labels.ts) and JSON-shaped
// fields (paraMap, rects, linkedCardIds, tags) are String columns holding JSON
// text ((de)serialized by src/lib/jsonFields.ts) — so the app code is identical
// on either database.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Auth (Auth.js Prisma adapter) ----

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  /**
   * Which one time explanations this person has already dismissed. Held
   * against the account rather than the browser: dismissing a tip on the
   * laptop should also dismiss it on the desktop, and signing in again is
   * not a reason to be taught the app a second time.
   */
  tipsSeen String[] @default([])

  accounts    Account[]
  sessions    Session[]
  matters     Matter[]
  apiTokens   ApiToken[]
  oauthCodes  OAuthCode[]
  oauthTokens OAuthToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Matter {
  id             String   @id @default(cuid())
  /// owner — every matter is private to the user who created it
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String

  /**
   * MatterKind: CASE | PROJECT.
   *
   * A case is litigation: it has a court, a case number, annexures and a
   * plaint to answer. A project is any other body of reading. The kind
   * decides which screens exist and what the card types are called; it does
   * not change how anything is stored, so a matter can change kind without
   * orphaning a single card.
   */
  kind           String   @default("CASE")
  court          String   @default("")
  caseNumber     String   @default("")
  parties        String   @default("")
  /// OurSide: PETITIONER_PLAINTIFF | RESPONDENT_DEFENDANT | OTHER
  ourSide        String   @default("OTHER")
  /// MatterStatus: ACTIVE | ARCHIVED
  status         String   @default("ACTIVE")
  /// per-matter switch to disable AI features (confidentiality restrictions)
  aiEnabled      Boolean  @default(true)
  /// annexure label prefix, e.g. "P" or "R"; empty = derive from ourSide
  annexurePrefix String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String   @default("local")

  documents         Document[]
  cards             Card[]
  chronologyEntries ChronologyEntry[]
  traverseSheet     TraverseSheet?
  artefacts         GeneratedArtefact[]
  annexureItems     AnnexureItem[]
  cardLinks         CardLink[]

  @@index([userId])
}

model Document {
  id            String   @id @default(cuid())
  matterId      String
  matter        Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  filename      String
  /// DocType: PLAINT | WRITTEN_STATEMENT | PETITION | REPLY | REJOINDER | JUDGMENT | ORDER | ANNEXURE | CORRESPONDENCE | MISC
  docType       String   @default("MISC")
  annexureLabel String?
  storagePath   String
  pageCount     Int      @default(0)
  hasTextLayer  Boolean  @default(true)
  /// JSON text: list of { label: string, page: number, y: number } paragraph markers in reading order
  paraMap       String   @default("[]")
  status        String   @default("ready")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String   @default("local")

  pages DocumentPage[]
  cards Card[]

  @@index([matterId])
}

model DocumentPage {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  page       Int
  text       String

  @@unique([documentId, page])
}

model Card {
  id          String    @id @default(cuid())
  matterId    String
  matter      Matter    @relation(fields: [matterId], references: [id], onDelete: Cascade)
  documentId  String?
  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  page        Int?
  para        String?
  /// exact highlighted source text
  quote       String    @default("")
  /// JSON text: normalized highlight rects [{ page, x, y, w, h }] with 0..1 coords
  rects       String    @default("[]")
  /// web captures (browser extension): source page URL + title
  sourceUrl   String?
  sourceTitle String?

  /// CardType: FACT | DATE | ISSUE | OUR_ARGUMENT | THEIR_ARGUMENT | EVIDENCE | CASE_LAW | ADMISSION | QUESTION | MISC
  cardType  String    @default("MISC")
  body      String    @default("")
  eventDate DateTime?
  /// JSON text: string[] of tags
  tags      String    @default("[]")
  pinned    Boolean   @default(false)

  citation    String?
  linksFrom   CardLink[] @relation("LinkFrom")
  linksTo     CardLink[] @relation("LinkTo")
  proposition String?
  /// Treatment: RELIED_ON | DISTINGUISHED | OVERRULED_RISK (nullable)
  treatment   String?

  /**
   * A reminder the user set on a personal note. remindSentAt is stamped once
   * the mail has gone, so a job that runs twice in a day does not send twice.
   */
  remindAt     DateTime?
  remindSentAt DateTime?

  orderIndex Float    @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String   @default("local")

  chronologyEntries ChronologyEntry[]

  @@index([matterId, cardType])
  @@index([documentId])
  @@index([remindAt])
}

model TraverseSheet {
  id         String   @id @default(cuid())
  matterId   String   @unique
  matter     Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  documentId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdBy  String   @default("local")

  rows TraverseRow[]
}

model TraverseRow {
  id            String        @id @default(cuid())
  sheetId       String
  sheet         TraverseSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  order         Int
  paraNo        String
  paraText      String
  /// rich text (HTML) reply
  responseText  String        @default("")
  /// TraverseStatus: NOT_STARTED | DENIED_BARE | DENIED_SPECIFIC | ADMITTED | ADMITTED_PARTLY | LEGAL_OBJECTION
  status        String        @default("NOT_STARTED")
  /// JSON text: ids of Fact/Evidence cards attached to this row
  linkedCardIds String        @default("[]")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([sheetId, order])
}

model GeneratedArtefact {
  id             String   @id @default(cuid())
  matterId       String
  matter         Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  /// ArtefactType: SENIOR_BRIEF | WRITTEN_SUBMISSIONS | JUDGE_NOTE | LIST_OF_DATES | CONVENIENCE_COMPILATION | WRITTEN_STATEMENT_DRAFT
  artefactType   String
  title          String
  /// rich text (HTML) content
  content        String   @default("")
  version        Int      @default(1)
  /// prompt snapshot for AI-generated versions
  promptSnapshot String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String   @default("local")

  @@index([matterId, artefactType])
}

/// Annexure registry: ordered mapping of documents to labels (PRD F8).
/// Labels are computed from position + the matter's prefix and mirrored to
/// Document.annexureLabel on every renumber.
model AnnexureItem {
  id         String   @id @default(cuid())
  matterId   String
  matter     Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  documentId String   @unique
  position   Int
  createdAt  DateTime @default(now())

  @@index([matterId, position])
}

/// Bearer tokens for cross-origin clients (browser extension, remote add-ins).
/// Each token belongs to a user; requests it authenticates act as that user.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([userId])
}

model ChronologyEntry {
  id              String   @id @default(cuid())
  matterId        String
  matter          Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  eventDate       DateTime
  description     String
  sourceCardId    String?  @unique
  sourceCard      Card?    @relation(fields: [sourceCardId], references: [id], onDelete: Cascade)
  includeInFiling Boolean  @default(true)
  sortOrder       Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String   @default("local")

  @@index([matterId, eventDate])
}

/// OAuth 2.1 authorization server, so an MCP client (Claude, ChatGPT) can
/// connect by consent rather than by the user pasting an API token. Clients
/// register themselves (RFC 7591); every code and token is bound to one user,
/// one client and one resource (RFC 8707 audience binding).
model OAuthClient {
  id           String   @id @default(cuid())
  clientId     String   @unique
  clientName   String   @default("An MCP client")
  /// JSON text: string[] of registered redirect URIs
  redirectUris String   @default("[]")
  createdAt    DateTime @default(now())

  codes  OAuthCode[]
  tokens OAuthToken[]
}

model OAuthCode {
  id            String      @id @default(cuid())
  /// sha256 of the authorization code; the code itself is never stored
  codeHash      String      @unique
  clientId      String
  client        OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  redirectUri   String
  /// PKCE S256 challenge
  codeChallenge String
  resource      String
  scope         String      @default("mcp")
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([userId])
  @@index([clientId])
}

model OAuthToken {
  id          String      @id @default(cuid())
  tokenHash   String      @unique
  refreshHash String?     @unique
  clientId    String
  client      OAuthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// the MCP endpoint this token is valid for; validated on every call
  resource    String
  scope       String      @default("mcp")
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime    @default(now())

  @@index([userId])
  @@index([clientId])
}

/// A link between two cards: the plaint paragraph and the annexure it refers
/// to, an admission and the document that contradicts it. Cards rather than raw
/// selections, so both ends carry their citation and survive into exports.
model CardLink {
  id         String   @id @default(cuid())
  matterId   String
  matter     Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  fromCardId String
  fromCard   Card     @relation("LinkFrom", fields: [fromCardId], references: [id], onDelete: Cascade)
  toCardId   String
  toCard     Card     @relation("LinkTo", fields: [toCardId], references: [id], onDelete: Cascade)
  /// LinkKind: REFERS_TO | SUPPORTS | CONTRADICTS | RELATES_TO
  kind       String   @default("RELATES_TO")
  note       String   @default("")
  /// set when the link was proposed by the annexure reference detector rather
  /// than drawn by the user, so suggestions can be shown differently
  suggested  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([fromCardId, toCardId])
  @@index([matterId])
}
